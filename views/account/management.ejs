<div class="account-management">
  <h1><%= title %></h1>

  <!-- Greeting -->
  <h2>Welcome <%= account.account_firstname %></h2>

  <!-- Update account link (always visible) -->
  <p><a href="/account/update/<%= account.account_id %>">Update Account Information</a></p>

  <!-- Conditional rendering based on account type -->
  <% if (account.account_type === 'Client') { %>
    <!-- Client sees only greeting + update link -->
  <% } else if (account.account_type === 'Employee' || account.account_type === 'Admin') { %>
    <h3>Inventory Management</h3>
    <p><a href="/inv/">Go to Inventory Management</a></p>
  <% } %>
</div>
