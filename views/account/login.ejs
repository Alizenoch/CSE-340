<!-- Flash messages -->
<% if (notice && notice.length > 0) { %>
  <% notice.forEach(function(msg){ %>
    <div class="flash-notice"><%= msg %></div>
  <% }) %>
<% } %>

<% if (messages && messages.error) { %>
  <div class="flash-error"><%= messages.error %></div>
<% } %>

<% if (messages && messages.success) { %>
  <div class="flash-success"><%= messages.success %></div>
<% } %>

<section class="login-form">
  <!-- ✅ Updated: id changed to "loginForm" -->
  <form id="loginForm" action="/account/login" method="post">
    <div class="form-group">
      <label for="account_email">Email Address:</label>
      <!-- ✅ Updated: name changed to "account_email" -->
      <input type="email" id="account_email" name="email" required placeholder="Enter your email">
    </div>

    <div class="form-group">
      <label for="account_password">Password:</label>
      <!-- ✅ Updated: name changed to "account_password" -->
      <input type="password" id="account_password" name="password" required placeholder="Enter your password">
    </div>

    <button type="submit">LOGIN</button>
  </form>

  <!-- Registration Link-->
  <p class="register-link">
    No account? <a href="/account/register">Sign-up</a>
  </p>
</section>



           


        

    